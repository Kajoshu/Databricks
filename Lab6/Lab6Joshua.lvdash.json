{
  "datasets": [
    {
      "name": "6de10f48",
      "displayName": "KPI1Data",
      "queryLines": [
        "SELECT \n",
        "    COUNT(*) AS total_observations,\n",
        "    COUNT(DISTINCT icao24) AS unique_aircraft,\n",
        "    COUNT(DISTINCT country_code) AS active_countries\n",
        "FROM dbr_dev.joshuandegwa_gold.lab5_gold_fact_flight_observations;\n",
        "\n"
      ],
      "catalog": "workspace",
      "schema": "lab5_gold"
    },
    {
      "name": "flight_observations",
      "displayName": "Flight Observations by Country",
      "queryLines": [
        "SELECT\n",
        "  country_code,\n",
        "  observation_timestamp,\n",
        "  icao24,\n",
        "  callsign,\n",
        "  baro_altitude,\n",
        "  velocity,\n",
        "  vertical_rate,\n",
        "  on_ground\n",
        "FROM\n",
        "  dbr_dev.joshuandegwa_gold.lab5_gold_fact_flight_observations\n",
        "ORDER BY\n",
        "  country_code"
      ]
    },
    {
      "name": "704e796c",
      "displayName": "Top Flight Counts and Altitude by Country Analysis",
      "queryLines": [
        "-- Ranks top countries by total flight observations to display regional airspace congestion\n",
        "SELECT \n",
        "    country_code,\n",
        "    COUNT(*) AS flight_count,\n",
        "    ROUND(AVG(baro_altitude), 2) AS avg_altitude\n",
        "FROM dbr_dev.joshuandegwa_gold.lab5_gold_fact_flight_observations\n",
        "GROUP BY country_code\n",
        "ORDER BY flight_count DESC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "top_countries",
      "displayName": "Top Countries by Flight Count",
      "queryLines": [
        "SELECT\n",
        "  country_code,\n",
        "  COUNT(*) AS flight_count,\n",
        "  ROUND(AVG(baro_altitude), 2) AS avg_altitude\n",
        "FROM\n",
        "  dbr_dev.joshuandegwa_gold.lab5_gold_fact_flight_observations\n",
        "GROUP BY\n",
        "  country_code\n",
        "HAVING\n",
        "  COUNT(*) >= 10\n",
        "ORDER BY\n",
        "  flight_count DESC"
      ]
    },
    {
      "name": "fastest_callsigns",
      "displayName": "Aircraft Performance Clusters",
      "queryLines": [
        "SELECT\n",
        "  a.callsign,\n",
        "  f.country_code,\n",
        "  ROUND(AVG(f.baro_altitude), 2) AS avg_altitude,\n",
        "  ROUND(AVG(f.velocity), 2) AS avg_velocity\n",
        "FROM\n",
        "  dbr_dev.joshuandegwa_gold.lab5_gold_fact_flight_observations f\n",
        "    JOIN dbr_dev.joshuandegwa_gold.lab5_gold_dim_aircraft a\n",
        "      ON f.icao24 = a.icao24\n",
        "GROUP BY\n",
        "  a.callsign,\n",
        "  f.country_code\n",
        "ORDER BY\n",
        "  avg_velocity DESC"
      ]
    },
    {
      "name": "vertical_patterns",
      "displayName": "Vertical Flight Patterns by Country",
      "queryLines": [
        "-- SELECT\n",
        "--   country_code,\n",
        "--   ROUND(AVG(vertical_rate), 2) AS avg_vertical_rate,\n",
        "--   COUNT(*) AS tracking_events\n",
        "-- FROM\n",
        "--   dbr_dev.joshuandegwa_gold.lab5_old_fact_flight_observations\n",
        "-- GROUP BY\n",
        "--   country_code\n",
        "-- ORDER BY\n",
        "--   ABS(avg_vertical_rate) DESC\n",
        "-- LIMIT 10\n"
      ]
    },
    {
      "name": "tracking_density",
      "displayName": "Aircraft Tracking Density by Country",
      "queryLines": [
        "SELECT\n",
        "  country_code,\n",
        "  APPROX_COUNT_DISTINCT(icao24) AS unique_aircraft_count,\n",
        "  COUNT(*) AS total_pings,\n",
        "  ROUND(COUNT(*) * 1.0 / NULLIF(APPROX_COUNT_DISTINCT(icao24), 0), 2) AS pings_per_aircraft_ratio\n",
        "FROM\n",
        "  dbr_dev.joshuandegwa_gold.lab5_gold_fact_flight_observations\n",
        "GROUP BY\n",
        "  country_code\n",
        "ORDER BY\n",
        "  total_pings DESC\n",
        "LIMIT 10"
      ]
    }
  ],

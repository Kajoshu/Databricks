          }
        ],
        "measures": [
          {
            "name": "total_claims",
            "expr": "COUNT(claim_no)",
            "displayName": "Total Claims"
          },
          {
            "name": "total_sum_insured",
            "expr": "SUM(sum_insured)",
            "displayName": "Total Sum Insured",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "total_premium",
            "expr": "SUM(premium)",
            "displayName": "Total Premium",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "total_claim_amount",
            "expr": "SUM(total)",
            "displayName": "Total Claim Amount",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "suspicious_claims",
            "expr": "COUNT(claim_no) FILTER (WHERE suspicious_activity = true)",
            "displayName": "Suspicious Claims"
          }
        ]
      }
    },

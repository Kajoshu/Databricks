{
  "datasets": [
    {
      "name": "3e919ebb",
      "displayName": "customer_claim_policy_telematics_predicted",
      "config": {
        "version": "1.1",
        "source": "dbr_dev.joshuandegwa_gold.customer_claim_policy_telematics_predicted",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "a360d572",
      "displayName": "Claim Images Predicted",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  image_name,\n  claim_no,\n  chassis_no,\n  damage_prediction.label AS predicted_label,\n  damage_prediction.score AS confidence_score,\n  needs_review\nFROM dbr_dev.joshuandegwa_gold.claim_images_predicted\n",
        "dimensions": [
          {
            "name": "image_name",
            "expr": "image_name"
          },
          {
            "name": "claim_no",
            "expr": "claim_no"
          },
          {
            "name": "chassis_no",
            "expr": "chassis_no"
          },
          {
            "name": "predicted_label",
            "expr": "predicted_label",
            "displayName": "Predicted Label"
          },
          {
            "name": "confidence_score",
            "expr": "confidence_score",
            "displayName": "Confidence Score"
          },
          {
            "name": "needs_review",
            "expr": "needs_review",
            "displayName": "Needs Review"
          }
        ],
        "measures": [
          {
            "name": "image_count",
            "expr": "COUNT(*)",
            "displayName": "Image Count"
          },
          {
            "name": "review_count",
            "expr": "COUNT(*) FILTER (WHERE needs_review = true)",
            "displayName": "Images for Review"
          },
          {
            "name": "avg_confidence",
            "expr": "AVG(confidence_score)",
            "displayName": "Avg Confidence",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "42cfcb3b",
      "displayName": "customer_claim_policy",
